{
  "name": "deepseek-usage",
  "version": "0.1.8",
  "description": "DSH DeepSeek 用量与限额面板：每日 Token/CNY 限额与后续调用熔断，侧边栏指标支持开关、改名、换图标和排序；复用 DSH 登录态读取 DeepSeek 平台账户余额/账单，按可编辑逐模型费率估算全部 Provider 本机会话，提供用量日历、趋势和模型/会话排行。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdiwenchen-lang/DeepSeek-Usage.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./plugin": "./src/index.js",
    "./client": "./src/client.js",
    "./account": "./src/account.js",
    "./apiclient": "./src/apiclient.js",
    "./cache": "./src/cache.js",
    "./http": "./src/http.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "pack:check": "node scripts/check-package.js",
    "bundle:check": "node -e \"const fs=require('fs');const s=fs.statSync('src/client.js').size;if(s>126976){console.error('bundle too large: '+s+'B > 126976B');process.exit(1)}console.log('bundle OK: '+s+'B');\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "official-usage",
    "billing",
    "dsh-bundle",
    "cordis-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}

{
  "name": "deepseek-usage",
  "version": "0.1.7",
  "description": "DSH 里的 DeepSeek 用量面板：查看官方账户余额与账单、每日用量日历，按可编辑的逐模型费率估算全部 Provider 的本地会话用量；支持会话 Token 与预估费用统计、侧边栏状态栏标签和图标自定义，以及每日 Token／金额限额与全会话后续模型调用熔断。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdiwenchen-lang/DeepSeek-Usage.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./plugin": "./src/index.js",
    "./client": "./src/client.js",
    "./account": "./src/account.js",
    "./apiclient": "./src/apiclient.js",
    "./cache": "./src/cache.js",
    "./http": "./src/http.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "icon.svg",
    "locale",
    "docs",
    "CONTEXT.md",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "bundle:check": "node -e \"const fs=require('fs');const s=fs.statSync('src/client.js').size;if(s>126976){console.error('bundle too large: '+s+'B > 126976B');process.exit(1)}console.log('bundle OK: '+s+'B');\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "official-usage",
    "billing",
    "dsh-bundle",
    "cordis-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
